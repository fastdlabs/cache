parameters:
	ignoreErrors:
		-
			message: "#^Call to an undefined method Symfony\\\\Component\\\\Cache\\\\Adapter\\\\MemcachedAdapter\\:\\:getStats\\(\\)\\.$#"
			count: 1
			path: src/CachePool.php

		-
			message: "#^Call to an undefined method Symfony\\\\Component\\\\Cache\\\\Adapter\\\\RedisAdapter\\:\\:ping\\(\\)\\.$#"
			count: 1
			path: src/CachePool.php

		-
			message: "#^Method FastD\\\\Cache\\\\Middleware\\\\XMCache\\:\\:getFromCache\\(\\) should return Psr\\\\Http\\\\Message\\\\ResponseInterface\\|null but returns Psr\\\\Http\\\\Message\\\\MessageInterface\\.$#"
			count: 1
			path: src/Middleware/XMCache.php

		-
			message: "#^Call to an undefined method FastD\\\\Container\\\\Container\\:\\:config\\(\\)\\.$#"
			count: 1
			path: src/ServiceProvider/CacheServiceProvider.php

		-
			message: "#^Call to an undefined method FastD\\\\Container\\\\Container\\:\\:config\\(\\)\\.$#"
			count: 1
			path: src/ServiceProvider/ServerRequestCacheProvider.php
