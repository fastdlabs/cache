{
    "name": "fastd/cache",
    "license": "MIT",
    "authors": [
        {
            "name": "JanHuang",
            "email": "384099566@qq.com"
        }
    ],
    "require": {
        "symfony/cache": "^8.0",
        "php": ">=8.4.1"
    },
    "require-dev": {
        "symfony/console": "^8.0",
        "predis/predis": "^3.0",
        "phpunit/phpunit": "^13.4",
        "fastd/fastd": "^8.1",
        "phpstan/phpstan": "^2.3"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "8.1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "FastD\\Cache\\": "src"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "tests": "tests"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-clover=build/logs/clover.xml --coverage-html=build/coverage",
        "test-coverage-clover": "phpunit --coverage-clover=build/logs/clover.xml"
    }
}
